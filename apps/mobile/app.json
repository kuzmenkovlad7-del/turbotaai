{
  "expo": {
    "name": "TurbotaAI",
    "slug": "turbotaai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "turbotaai",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#7c3aed"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.turbotaai.app",
      "buildNumber": "1",
      "usesNonExemptEncryption": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "TurbotaAI uses your microphone for real-time voice and video calls with your AI assistant.",
        "NSCameraUsageDescription": "TurbotaAI uses your camera for video calls with your AI assistant."
      },
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#7c3aed"
      },
      "package": "com.turbotaai.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "com.android.vending.BILLING"
      ],
      "runtimeVersion": "1.0.0"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      "expo-localization",
      [
        "expo-av",
        {
          "microphonePermission": "TurbotaAI uses your microphone for real-time voice calls with your AI assistant."
        }
      ],
      [
        "react-native-iap",
        {
          "paymentProvider": "both"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ccee3342-9f65-416e-a5df-adc7470539c4"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ccee3342-9f65-416e-a5df-adc7470539c4"
    }
  }
}
