# Backend API URL (your deployed TurbotaAI web app)
EXPO_PUBLIC_API_URL=https://turbotaai.com

# Supabase credentials (same as web app's NEXT_PUBLIC_* values)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...your_anon_key

# Set to "true" to enable IAP purchase buttons (requires dev build + store setup)
EXPO_PUBLIC_IAP_ENABLED=false

# Set to "true" for any build submitted to the App Store or Google Play.
# Hides the "Subscribe on turbotaai.com" external CTA (not permitted by store
# guidelines for digital-content apps).  On iOS the CTA is ALWAYS hidden
# regardless of this flag (platform-level safeguard in AccountScreen).
# EAS production-ios / production-android / production profiles set this
# automatically — you only need to set it manually for local store-build tests.
EXPO_PUBLIC_STORE_BUILD=false

# Set to "true" to show debug diagnostics overlay on WebView screens
EXPO_PUBLIC_DEBUG=false
